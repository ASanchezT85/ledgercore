# LedgerCore — environment template.
#
# For a plain local run you need NONE of this: infra/compose/docker-compose.yml
# carries safe "*_dev" defaults for every variable below, so
# `docker compose -f infra/compose/docker-compose.yml up -d --build` works from
# a bare clone.
#
# Copy this file to infra/compose/.env to override any of it. That file is
# git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Published host ports
# ---------------------------------------------------------------------------
# Change these when something else already occupies the default. Only the
# gateway is needed to use the API; the per-service ports are published for
# convenience during development.
LEDGERCORE_GATEWAY_PORT=8080
LEDGERCORE_TRAEFIK_DASHBOARD_PORT=8090
LEDGERCORE_LEDGER_PORT=8081
LEDGERCORE_IDENTITY_PORT=8082
LEDGERCORE_RECON_PORT=8083
LEDGERCORE_WEBHOOKS_PORT=8084
LEDGERCORE_POSTGRES_PORT=5432
LEDGERCORE_CONSOLE_PORT=3000
LEDGERCORE_GRAFANA_PORT=3100

# NATS is not published to the host at all: nothing outside the compose network
# talks to it. Use `docker compose exec nats ...` if you need to inspect it.

# ---------------------------------------------------------------------------
# Development behaviour
# ---------------------------------------------------------------------------
# With auth disabled the tenant is taken from the X-Tenant-Id header. This is
# for local development only. Set it to false to exercise the real API key ->
# JWT -> JWKS path.
LEDGERCORE_AUTH_DISABLED=true

# ---------------------------------------------------------------------------
# Secrets — REQUIRED for any deployment that is not your laptop
# ---------------------------------------------------------------------------
# The hardened overlay (infra/compose/docker-compose.sandbox.yml) declares these
# with ${VAR:?}, so Compose refuses to start when one is missing. That is
# deliberate: a real deployment must never boot with the repository's dev
# defaults. Generate every value randomly and never reuse one across roles.

# Public hostname and the ACME contact address for TLS.
LEDGERCORE_DOMAIN=ledger.example.com
LEDGERCORE_ACME_EMAIL=ops@example.com

# PostgreSQL superuser password.            openssl rand -hex 24
POSTGRES_PASSWORD=

# 32-byte hex master key.                   openssl rand -hex 32
# Encrypts the JWT signing keys (identity) and the webhook subscription
# secrets (webhooks) at rest. Losing it means both become unreadable; leaking
# it means both must be rotated.
LEDGERCORE_MASTER_KEY=

# Bootstrap token for identity's admin endpoints.  openssl rand -hex 32
LEDGERCORE_ADMIN_TOKEN=

# One DISTINCT random password per database role.  openssl rand -hex 24
# Separate roles are the blast-radius boundary: a compromised service must not
# be able to authenticate as another one.
LEDGERCORE_MIGRATOR_PASSWORD=
LEDGERCORE_LEDGER_RT_PASSWORD=
LEDGERCORE_IDENTITY_RT_PASSWORD=
LEDGERCORE_RECON_RT_PASSWORD=
LEDGERCORE_WEBHOOKS_RT_PASSWORD=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# OpenTelemetry is wired through the standard OTEL_* variables and is a no-op
# when they are unset. The `obs` compose profile starts a local collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
# OTEL_SERVICE_NAME=ledger-core
