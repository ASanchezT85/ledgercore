{
    "name": "ledgercore/sdk",
    "description": "Official PHP SDK for the LedgerCore API (double-entry ledger as a service).",
    "type": "library",
    "license": "MIT",
    "keywords": ["ledger", "double-entry", "accounting", "fintech", "ledgercore"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "LedgerCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LedgerCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
