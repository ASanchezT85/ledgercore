{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ledgercore.dev/events/ledger.hold.created.schema.json",
  "title": "LedgerHoldCreated",
  "description": "Payload of ledger.hold.created: funds were reserved on an account.",
  "type": "object",
  "required": ["hold_id", "ledger_id", "account_id", "amount", "expires_at", "created_at"],
  "properties": {
    "hold_id": { "type": "string", "format": "uuid" },
    "ledger_id": { "type": "string", "format": "uuid" },
    "account_id": { "type": "string", "format": "uuid" },
    "idempotency_key": { "type": "string", "maxLength": 255 },
    "amount": { "$ref": "envelope.schema.json#money" },
    "expires_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "hold_id": "8b7c3d5e-6f7a-7b8c-e3b5-2d3e4f5a6b7c",
