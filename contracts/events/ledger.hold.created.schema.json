      "idempotency_key": "auth-2026-0042",
      "amount": { "asset": "USD", "amount": "2500" },
      "expires_at": "2026-07-31T00:00:00Z",
      "created_at": "2026-07-24T13:00:00Z"
    }
  ]
}
