{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ledgercore.dev/events/ledger.hold.released.schema.json",
  "title": "LedgerHoldReleased",
  "description": "Payload of ledger.hold.released: reserved funds were freed without moving money (explicit release or expiry).",
  "type": "object",
  "required": ["hold_id", "ledger_id", "account_id", "amount", "reason", "released_at"],
  "properties": {
    "hold_id": { "type": "string", "format": "uuid" },
    "ledger_id": { "type": "string", "format": "uuid" },
    "account_id": { "type": "string", "format": "uuid" },
    "amount": { "$ref": "envelope.schema.json#money" },
    "reason": {
      "type": "string",
      "enum": ["released", "expired"],
      "description": "Whether the release was explicit or due to expiry."
    },
    "released_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "hold_id": "8b7c3d5e-6f7a-7b8c-e3b5-2d3e4f5a6b7c",
      "ledger_id": "1f0a6a2e-9c1b-7f2e-8a11-3c5d7e9f0b21",
      "account_id": "2b1c7d3f-0a2b-7c4d-9e50-6f8a0b1c2d3e",
      "amount": { "asset": "USD", "amount": "2500" },
      "reason": "expired",
      "released_at": "2026-07-31T00:00:05Z"
    }
  ]
}
