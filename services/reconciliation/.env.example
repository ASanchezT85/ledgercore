# Configuración del servicio reconciliation (puerto 8083, schema "recon").
# Copia este archivo a .env y ajusta según tu entorno. Credenciales SOLO dev.

# Dirección de escucha del servidor HTTP.
LEDGERCORE_HTTP_ADDR=:8083

# PostgreSQL 17 (instancia dev compartida; este servicio solo usa el schema "recon").
LEDGERCORE_DATABASE_URL=postgres://ledgercore_app:ledgercore_dev@localhost:5432/ledgercore?sslmode=disable

# NATS JetStream. Si se deja vacía, el servicio arranca sin consumer de espejo
# ni poller de outbox (solo API).
LEDGERCORE_NATS_URL=nats://localhost:4222

# JWKS del servicio identity para validar JWT EdDSA.
LEDGERCORE_JWKS_URL=http://localhost:8082/v1/keys/jwks.json

# SOLO dev: true hace que el middleware tome el tenant del header X-Tenant-Id.
LEDGERCORE_AUTH_DISABLED=true

# Ejecuta las migraciones goose embebidas al arrancar.
LEDGERCORE_AUTO_MIGRATE=true

# OpenTelemetry (opcional; sin definir = telemetría no-op).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
