# Identity service — variables de entorno (valores SOLO para desarrollo local)

# Dirección de escucha HTTP (puerto asignado: 8082)
LEDGERCORE_HTTP_ADDR=:8082

# Postgres compartida de dev; el servicio fija search_path=identity y jamás
# toca otros schemas. Credenciales solo-dev del compose.
LEDGERCORE_DATABASE_URL=postgres://ledgercore_app:ledgercore_dev@localhost:5432/ledgercore?sslmode=disable

# Aplica las migraciones goose embebidas al arrancar.
LEDGERCORE_AUTO_MIGRATE=true

# Token de bootstrap para los endpoints admin (X-Admin-Token). Si se omite,
# los endpoints admin quedan deshabilitados (fail closed).
LEDGERCORE_ADMIN_TOKEN=dev-admin-token

# --- Variables estándar de la plataforma que ESTE servicio no consume ---
# identity ES el emisor del JWKS; no valida tokens contra otro servicio y no
# publica eventos. Se listan por consistencia con el resto de servicios.
# LEDGERCORE_JWKS_URL=http://localhost:8082/.well-known/jwks.json
# LEDGERCORE_AUTH_DISABLED=false
# LEDGERCORE_NATS_URL=nats://localhost:4222

# OpenTelemetry (opcional; si no está seteada, la telemetría es no-op)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
