# ledger-core — variables de entorno (valores SOLO para desarrollo local)

# Dirección HTTP del servicio (puerto 8081 por convención del monorepo).
LEDGERCORE_HTTP_ADDR=:8081

# Postgres 17 compartido de dev; este servicio usa EXCLUSIVAMENTE el schema "ledger".
LEDGERCORE_DATABASE_URL=postgres://ledgercore_app:ledgercore_dev@localhost:5432/ledgercore?sslmode=disable

# NATS JetStream. Vacío = el poller del outbox no arranca (los eventos quedan en la tabla).
LEDGERCORE_NATS_URL=nats://localhost:4222

# JWKS del servicio identity para validar JWT EdDSA.
LEDGERCORE_JWKS_URL=http://localhost:8082/.well-known/jwks.json

# true SOLO en dev: toma el tenant del header X-Tenant-Id en vez de validar JWT.
LEDGERCORE_AUTH_DISABLED=true

# true = aplica las migraciones goose embebidas al arrancar.
LEDGERCORE_AUTO_MIGRATE=true

# OpenTelemetry (estándar). Sin definir = telemetría no-op.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Solo para tests de integración (go test): si no está definida, se saltan.
# LEDGERCORE_TEST_DATABASE_URL=postgres://ledgercore_app:ledgercore_dev@localhost:5432/ledgercore_test?sslmode=disable
