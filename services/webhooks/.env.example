# Configuración del servicio webhooks (valores SOLO para desarrollo local).

# Dirección de escucha HTTP (puerto asignado al servicio: 8084).
LEDGERCORE_HTTP_ADDR=:8084

# Postgres compartida de dev; el servicio fija search_path=webhooks y jamás
# toca otros schemas. Credenciales solo-dev del compose.
LEDGERCORE_DATABASE_URL=postgres://ledgercore_app:ledgercore_dev@localhost:5432/ledgercore?sslmode=disable

# NATS JetStream.
LEDGERCORE_NATS_URL=nats://localhost:4222

# JWKS del servicio identity (validación de JWT EdDSA).
LEDGERCORE_JWKS_URL=http://localhost:8082/.well-known/jwks.json

# SOLO dev: si es true, /v1 toma el tenant del header X-Tenant-Id sin JWT.
LEDGERCORE_AUTH_DISABLED=true

# Ejecutar migraciones goose embebidas al arrancar.
LEDGERCORE_AUTO_MIGRATE=true

# Tests de integración (si no está definida, se saltan):
# LEDGERCORE_TEST_DATABASE_URL=postgres://ledgercore_app:ledgercore_dev@localhost:5432/ledgercore_test?sslmode=disable

# OpenTelemetry (opcional; sin definir = no-op).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
