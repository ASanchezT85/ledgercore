# LedgerCore compose environment — TEMPLATE.
#
# Copy to infra/compose/.env and fill in real values. The real .env is
# git-ignored and MUST NEVER be committed or shipped in an audit package
# (use scripts/export-clean.sh, which emits only git-tracked files).
#
# ---------------------------------------------------------------------------
# Local dev (docker-compose.yml only)
# ---------------------------------------------------------------------------
# Nothing here is required for local dev: docker-compose.yml carries safe
# "*_dev" defaults for every variable below. Set a value only to override a
# default (e.g. after re-encrypting with a custom master key).
#
# ---------------------------------------------------------------------------
# Public sandbox (docker-compose.sandbox.yml) — ALL of the following are
# REQUIRED. The overlay uses ${VAR:?}, so compose refuses to start if any is
# missing. Generate every secret randomly; never reuse a repo default.
# ---------------------------------------------------------------------------

# Public FQDN, ACME contact, and Let's Encrypt.
LEDGERCORE_DOMAIN=sandbox.ledgercore.example
LEDGERCORE_ACME_EMAIL=ops@example.com

# Superuser password for Postgres (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Signing/secret master key — 32-byte hex (openssl rand -hex 32). Encrypts JWT
# signing keys (identity) AND webhook subscription secrets (webhooks) at rest.
LEDGERCORE_MASTER_KEY=

# Identity admin bootstrap token (openssl rand -hex 32).
LEDGERCORE_ADMIN_TOKEN=

# Per-role DB passwords (R-003). Generate a DISTINCT random value per role
# (openssl rand -hex 24). In production NONE of these may be a "*_dev" value:
# a compromised service must not be able to authenticate as another role with
# a password that is public in the repo.
LEDGERCORE_MIGRATOR_PASSWORD=
LEDGERCORE_LEDGER_RT_PASSWORD=
LEDGERCORE_IDENTITY_RT_PASSWORD=
LEDGERCORE_RECON_RT_PASSWORD=
LEDGERCORE_WEBHOOKS_RT_PASSWORD=

# ---------------------------------------------------------------------------
# Shared-VPS overlay (docker-compose.vps-shared.yml) — in addition to above.
# ---------------------------------------------------------------------------
LEDGERCORE_BASE_DOMAIN=example.com
